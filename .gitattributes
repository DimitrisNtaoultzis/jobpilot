# Store all text files with LF (Linux-style) line endings,
# because the code runs on Linux (Docker, CI, Azure).
* text=auto eol=lf

# Exception: Windows scripts MUST use CRLF to run correctly
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: Git must never modify them
*.png binary
*.jpg binary
*.pdf binary
