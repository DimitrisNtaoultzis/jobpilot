# Copy this file to .env and fill in the values.
# .env is NEVER committed to Git (see .gitignore).

# LLM provider
GROQ_API_KEY=

# Django
# Generate a key with: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot
